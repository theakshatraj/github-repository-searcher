# ---------------------------------------------------------------------------
# Copy to .env and fill in real values for your machine. .env is git-ignored.
# Spring Boot does NOT read .env automatically: export these variables in your
# shell, set them in your IDE run configuration, or pass them with
# `docker run --env-file .env ...`.
# ---------------------------------------------------------------------------

# JDBC URL of the PostgreSQL database. Local default matches the Docker command
# in the README. Hosted providers usually give postgres://...; convert it to
# jdbc:postgresql://<host>:<port>/<database> and split the credentials below.
DB_URL=jdbc:postgresql://localhost:5432/github_searcher

# Database user. Local default used by the postgres:16 container.
DB_USERNAME=postgres

# Database password. Never commit the real value.
DB_PASSWORD=postgres

# Optional GitHub token. Without it GitHub allows only a few search requests per
# minute. A classic or fine-grained token with no scopes is enough for public
# search. Leave empty to call GitHub anonymously.
GITHUB_TOKEN=

# HTTP port. Most platforms inject PORT themselves; the app defaults to 8080.
PORT=8080

# Active Spring profile. Use `prod` for deployments, leave empty locally.
SPRING_PROFILES_ACTIVE=
